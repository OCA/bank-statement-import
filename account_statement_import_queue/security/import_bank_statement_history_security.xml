<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="import_bank_statement_history_rule" model="ir.rule">
        <field name="name">Import Bank Statement History Multi-Company</field>
        <field
            name="model_id"
            ref="account_statement_import_queue.model_import_bank_statement_history"
        />
        <field name="global" eval="True" />
        <field
            name="domain_force"
        >['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1" />
    </record>
</odoo>
