<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="model">account.journal</field>
        <field
            name="inherit_id"
            ref="account_statement_import_generate_unique_id.view_account_journal_form"
        />
        <field name="arch" type="xml">
            <field name="generate_unique_import_id" position="attributes">
                <attribute
                    name="readonly"
                >online_bank_statement_provider == 'fints'</attribute>
            </field>
        </field>
    </record>
</odoo>
