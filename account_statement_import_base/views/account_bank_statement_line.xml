<odoo>
    <record id="account_bank_statement_line_form" model="ir.ui.view">
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_statement_base.account_bank_statement_line_form"
        />
        <field name="arch" type="xml">
            <page name="technical" position="before">
                <page name="transaction_details" string="Transaction Details">
                    <group>
                        <group name="counterpart_details" string="Counterpart">
                            <field name="partner_email" widget="email" />
                            <field name="partner_phone" widget="phone" />
                            <field name="partner_street" />
                            <field name="partner_zip" />
                            <field name="partner_city" />
                            <field name="partner_state_name" />
                            <field name="partner_country_id" />
                            <field name="partner_external_ref" />
                        </group>
                        <group name="payment_details" string="Payment">
                            <field name="payment_method_type" />
                            <field name="card_masked_number" />
                            <field name="card_expiry_date" />
                            <field name="merchant_category" />
                            <field name="subscription_ref" />
                            <field name="provider_url" widget="url" />
                        </group>
                    </group>
                </page>
            </page>
            <group name="tech-fields" position="inside">
                <field name="unique_import_id" readonly="1" />
            </group>
            <group name="tech-fields" position="after">
                <group name="raw_data" string="Raw Data">
                    <field name="raw_data" nolabel="1" colspan="2" readonly="1" />
                </group>
            </group>
        </field>
    </record>

    <record id="account_bank_statement_line_tree" model="ir.ui.view">
        <field name="name">account.bank.statement.line.tree</field>
        <field name="model">account.bank.statement.line</field>
        <field
            name="inherit_id"
            ref="account_statement_base.account_bank_statement_line_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sequence']" position="after">
                <field name="unique_import_id" readonly="1" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
