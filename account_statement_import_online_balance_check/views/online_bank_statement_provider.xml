<odoo>
    <record id="online_bank_statement_provider_form" model="ir.ui.view">
        <field name="name">online.bank.statement.provider.form.balance.check</field>
        <field name="model">online.bank.statement.provider</field>
        <field
            name="inherit_id"
            ref="account_statement_import_online.online_bank_statement_provider_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(online_bank_statement_check_action)d"
                    type="action"
                    string="Check Statements"
                    context="{'default_provider_id': id}"
                />
            </xpath>
        </field>
    </record>
</odoo>
