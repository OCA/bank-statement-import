<odoo>
    <record id="account_statement_import_sheet_preprocessor_form" model="ir.ui.view">
        <field name="name">account.statement.import.sheet.preprocessor.form</field>
        <field name="model">account.statement.import.sheet.preprocessor</field>
        <field name="arch" type="xml">
            <form>
                <p>Test your preprocessor generates a valid CSV content</p>
                <group>
                    <group>
                        <field name="mapping_id" invisible="True" />
                        <field name="preprocessor_code" />
                    </group>
                    <group>
                        <field name="test_file" />
                        <field name="test_result" />
                    </group>
                </group>
                <footer>
                    <button
                        string="Close"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="account_statement_import_sheet_preprocessor_action"
        model="ir.actions.act_window"
    >
        <field name="name">Test Preprocessor</field>
        <field name="res_model">account.statement.import.sheet.preprocessor</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
